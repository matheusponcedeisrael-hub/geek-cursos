TextWindow.WriteLine("Entre com o valor de X")
X = TextWindow.Read()

TextWindow.WriteLine("Ensira o valor de Y")
Y = TextWindow.Read()

TextWindow.WriteLine("Entre com a largura ")
largura = TextWindow.Read()

TextWindow.WriteLine("Entre com o valor da altura")
Altura = TextWindow.Read()

GraphicsWindow.FillRectangle(X, Y,Largura,Altura)